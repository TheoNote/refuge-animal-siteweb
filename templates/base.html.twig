<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Refuge Animalier{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🐾</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="site-header">
            <div class="container nav-bar">
                <a href="{{ path('app_home') }}" class="brand">
                    <span class="brand-logo">🐾</span>
                    <span class="brand-name">Refuge<span>Animalier</span></span>
                </a>
                <nav class="main-nav">
                    <a href="{{ path('app_home') }}" class="is-active">Accueil</a>
                    <a href="#animaux">Les animaux</a>
                </nav>
                <div class="nav-actions">
                    {% if app.user %}
                        <span class="nav-user">{{ app.user.userIdentifier }}</span>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-outline">Connexion</a>
                        <a href="{{ path('register_user') }}" class="btn btn-primary">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </header>

        <main>
            <div class="container">
                {% for type in ['success', 'error'] %}
                    {% for message in app.flashes(type) %}
                        <p class="alert alert-{{ type }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
            </div>
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container footer-inner">
                <div class="brand brand-footer">
                    <span class="brand-logo">🐾</span>
                    <span class="brand-name">Refuge<span>Animalier</span></span>
                </div>
                <p class="footer-contact">📍 1 rue de l'Exemple, 00000 Ailleurs · 📞 00 00 00 00 00 · ✉️ contact@example.com</p>
                <p class="footer-copy">© {{ "now"|date("Y") }} Refuge Animalier — Données de démonstration.</p>
            </div>
        </footer>
    </body>
</html>
